# PR Review Agent configuration — copy to config.yaml (boot reads ./config.yaml).
# Fail-closed: an invalid file refuses to boot (SCN-IF-004-A2).
# Secrets are never stored here — only env-var NAMES via `auth_env` (REQ-NF-004).

providers:               # single app-layer model definition (REQ-016)
  free:    { provider: opencode,    model: deepseek-v4-flash-free, enabled: true,  auth_env: OPENCODE_GO_TOKEN }
  go:      { provider: opencode-go, model: deepseek-v4-pro,        enabled: true,  auth_env: OPENCODE_GO_TOKEN }
  gemini:  { provider: google-one,  model: gemini-2.5-pro,         enabled: false, auth_env: OPENCODE_GO_TOKEN }

default_model: free      # active alias — change here, no code change (REQ-016)
switch_default: go       # fallback alias on credit exhaustion (REQ-016)

repo_config:             # managed repos — webhook registration is the allow (REQ-003)
  - owner: br4vetrave1err
    repo: developer-roadmap
    default_model: free
    enabled: true

denylist: []             # subtracts within repo_config only (REQ-003)

defaults:
  concurrency: 1         # one review at a time (REQ-NF-006)
  disk_cap_bytes: 10737418240   # 10 GiB clone cache (REQ-005)
  validator_filter_enabled: true

ci_gate:                 # Rule B — green heads only (REQ-010)
  enabled: true
  settle_seconds: 75
  wait_cap_minutes: 60

reconcile_interval_seconds: 300

retry:
  max_attempts: 3        # initial + 2 retries, transient only (REQ-014)
  backoff_seconds: [30, 120]

specs_docs_dir: specs    # docs context: <root>/specs/<owner>/<repo>/ (REQ-006)
workspace_cache_dir: /var/agent_cache/repos   # isolated clone cache (REQ-005)
ngrok_agent_url: http://ngrok:4040   # REQ-CN-001: tunnel discovery + webhook self-heal

agent_skill_set:         # defined agent skill set (REQ-017)
  base: /code-review
  situational: [/diagnosing-bugs, /resolving-merge-conflicts]
