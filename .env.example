# PR Review Agent secrets — copy to .env (gitignored, REQ-NF-004).
# Delivered to the container via compose `env_file`; never committed.
# The entrypoint builds opencode's auth.json from OPENCODE_GO_TOKEN at boot.

# GitHub PAT with `repo` scope (REQ-IF-001)
GITHUB_TOKEN=ghp_your_github_pat_here

# Webhook HMAC secret — at least 16 chars (REQ-001); must match the registered webhook
WEBHOOK_SECRET=change-me-to-a-long-random-secret

# GitHub account the agent reviews as (self-account for triggers, REQ-002)
PR_REVIEWER_ACCOUNT=your-github-username

# opencode provider token (REQ-IF-003); entrypoint writes it into auth.json
OPENCODE_GO_TOKEN=sk-your_opencode_token_here

# ngrok tunnel (REQ-CN-001) — must be present for the tunnel sidecar to start
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Slack Webhook URL for out-of-band review preview notifications (REQ-019)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# Slack App API Credentials for programmatic Request URL auto-update on boot (REQ-024, REQ-025)
SLACK_APP_ID=A0000000000
SLACK_USER_TOKEN=xoxp-your-user-token-here


